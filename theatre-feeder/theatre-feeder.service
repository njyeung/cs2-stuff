[Unit]
Description=Theatre video feeder for CSFleet
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=nick
WorkingDirectory=/home/nick
Environment="PATH=/home/nick/.deno/bin:/home/nick/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/nick/theatre-feeder -listen 172.30.0.1:8787
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=theatre-feeder

[Install]
WantedBy=multi-user.target
